; Aucune balise : la zone de depot est assez proche pour utiliser le recalage GPS pris avant la plongee.
(define (problem p10_sans_balise)
  (:domain naiad_scenario_1)
  (:objects
    t1 - tier1
    t3-1 t3-2 t3-3 t3-4 t3-5 - tier3
    navire - porteur
    zone-attente - lieu-attente
    zone-depot - lieu-depot
    zone-oceanisation - lieu-oceanisation
    final-1 final-2 final-3 final-4 final-5 - point-final
  )
  (:htn :parameters () :ordered-subtasks (and (mission t1)))
  (:init
    ; Tous les vehicules sont a bord du porteur ; le T1 se recale par GPS avant la plongee.
    (position t1 navire) (recale-sur t1 navire)
    (position t3-1 navire)
    (position t3-2 navire)
    (position t3-3 navire)
    (position t3-4 navire)
    (position t3-5 navire)
    ; Itineraire aller, du circuit d'attente a la zone de depot.
    (itineraire zone-attente zone-depot)
    ; Recalages assez precis pour deposer dans la zone de depot.
    (assez-precis navire zone-depot)
    ; Point final de chaque T3, et ordre d'atterrissage (le moins d'energie restante d'abord).
    (affecte t3-1 final-1)
    (affecte t3-2 final-2)
    (affecte t3-3 final-3)
    (affecte t3-4 final-4)
    (affecte t3-5 final-5)
    (premier-atterrissage t3-1)
    (atterrissage-suivant t3-1 t3-2)
    (atterrissage-suivant t3-2 t3-3)
    (atterrissage-suivant t3-3 t3-4)
    (atterrissage-suivant t3-4 t3-5)
  )
)
